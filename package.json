{
  "name": "white-chorus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "RUN_DATABASE_TESTS=1 vitest run tests/integration --no-file-parallelism --maxWorkers=1 --testTimeout=30000",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "env:validate": "tsx scripts/validate-env.ts",
    "staging:verify": "tsx scripts/verify-staging-services.ts",
    "db:assert-empty": "tsx scripts/assert-database-empty.ts",
    "assets:validate": "tsx scripts/validate-dress-up-assets.ts",
    "assets:validate:release": "REQUIRE_OFFICIAL_ASSETS=1 NEXT_PUBLIC_ASSET_MODE=production tsx scripts/validate-dress-up-assets.ts",
    "assets:generate:fixture": "tsx scripts/generate-fixture-dress-up-assets.ts",
    "assets:generate:derived": "tsx scripts/generate-derived-dress-up-assets.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "cron:expire": "tsx --conditions=react-server scripts/expire-submissions-manually.ts",
    "cron:daily": "tsx --conditions=react-server scripts/select-daily-winner-manually.ts",
    "cron:winner": "pnpm cron:daily"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.111.0",
    "framer-motion": "12.43.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
