APP_URL=http://localhost:3000

# Runtime traffic should use a pooled Supabase PostgreSQL URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Prisma CLI migrations should use a direct/session-mode URL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

SESSION_COOKIE_NAME=wc_guest
SESSION_TOKEN_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=604800
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-key
SUPABASE_STORAGE_BUCKET=white-chorus-generated

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_MODE=off

SESSION_CREATE_LIMIT_PER_HOUR=5
PUBLISH_LIMIT_PER_HOUR=5
PUBLISH_LIMIT_PER_DAY=15
PUBLISH_COOLDOWN_SECONDS=10
DUPLICATE_WINDOW_HOURS=24
RATING_LIMIT_PER_HOUR=30
INTERACTION_LIMIT_PER_HOUR=30
DOWNLOAD_LIMIT_PER_HOUR=60

SUBMISSION_RETENTION_DAYS=7
EXPIRED_TOMBSTONE_HOURS=24
GUEST_RETENTION_DAYS=14
STUCK_PROCESSING_MINUTES=15
FAILED_OUTFIT_RETENTION_DAYS=2

WEEKLY_TIMEZONE=Asia/Jakarta
WEEKLY_MIN_RATINGS=5
WEEKLY_WINNER_ENABLED=true
CRON_SECRET=replace-with-at-least-32-random-characters
INTERNAL_ADMIN_SECRET=replace-with-at-least-32-random-characters

# Keep fixture mode outside production until official art is supplied.
NEXT_PUBLIC_ASSET_MODE=fixture
